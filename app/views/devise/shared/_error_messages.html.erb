<% if resource.errors.any? %>
  <div class="alert alert-danger">
    <h5>
      <%= pluralize(resource.errors.count, "error") %>
      prohibited this form from being saved:
    </h5>

    <ul class="mb-0">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>